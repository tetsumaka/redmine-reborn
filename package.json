{
  "name": "redmine-time-tracker",
  "version": "1.0.0",
  "description": "Desktop time tracker with Redmine synchronization",
  "author": {
    "name": "TETSUKER",
    "email": "romantokmin.dev@gmail.com"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.main.json && tsc -p tsconfig.renderer.json && electron-vite build",
    "start": "npm run build && node scripts/start-electron.js",
    "dev": "electron-vite dev --watch",
    "dist": "npm run dist:linux",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "42.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0"
  },
  "build": {
    "appId": "ru.redmine.timetracker",
    "productName": "Redmine Time Tracker",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
